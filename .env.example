# Copy to .env or export in your shell. Every value is optional; defaults shown.
FRIDAY_HOME=~/FRIDAY                  # workspace folder (database, memory, reports, logs, backups)
FRIDAY_TZ=Asia/Kuala_Lumpur           # your timezone for reminders and "tomorrow 9am"
FRIDAY_HOST=127.0.0.1                 # keep local; use a VPN (Tailscale/WireGuard) or TLS to reach it from a phone
FRIDAY_PORT=8765
FRIDAY_AUTONOMY=2                     # initial autonomy level 0-4 (only used the first time)

# Brain: auto = use Ollama if reachable, otherwise the offline rules planner
FRIDAY_MODEL_PROVIDER=auto            # auto | ollama | openai | rules
FRIDAY_OLLAMA_URL=http://localhost:11434
FRIDAY_OLLAMA_MODEL=qwen2.5:7b-instruct   # any Ollama model that supports tool calling
# Optional per-task routing (model name, or provider:model)
# FRIDAY_MODEL_SIMPLE=llama3.2:3b
# FRIDAY_MODEL_CODING=qwen2.5-coder:7b
# FRIDAY_MODEL_REASONING=qwen2.5:14b-instruct

# Optional OpenAI-compatible backend (LM Studio, llama.cpp server, vLLM, hosted APIs)
# FRIDAY_OPENAI_BASE_URL=http://localhost:1234/v1
# FRIDAY_OPENAI_MODEL=...
# FRIDAY_OPENAI_API_KEY=...

# TLS for non-local access (otherwise tokens travel in clear text)
# FRIDAY_TLS_CERT=/path/cert.pem
# FRIDAY_TLS_KEY=/path/key.pem

# Browser tool: path to a Chromium if `playwright install chromium` is not possible
# FRIDAY_CHROMIUM_PATH=
